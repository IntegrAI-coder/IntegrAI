# IntegrAI — variables de entorno (plantilla).
# Copia este archivo a .env y rellena los valores. NUNCA commitees .env.
# En local, con MODO_MOCK=1 el sistema corre sin credenciales de AWS.

# --- Modo local ---
MODO_MOCK=1

# --- WhatsApp Cloud API (webhook) ---
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_WHITELIST=            # teléfonos autorizados, separados por coma (ej. 56900000001,56900000002)
WA_ALLOW_UNSIGNED=       # sale del repo público solo para desarrollo

# --- Backend / API ---
INTEGRA_API_TOKEN=
INTEGRA_BACKEND=http://localhost:8000
INTEGRA_CORS_ORIGINS=

# --- AWS (solo si MODO_MOCK != 1) ---
AWS_REGION=us-east-1
INTEGRA_S3_BUCKET=
INTEGRA_INSTANCE_ID=
INTEGRA_DISTRIBUTION_ID=
INTEGRA_ORIGIN_DOMAIN=
INTEGRA_ALARM_EMAIL=

# --- Umbrales / modelos (opcionales) ---
GATE_MARGEN=0.15
JUEZ_CONFIANZA_MIN=0.6
