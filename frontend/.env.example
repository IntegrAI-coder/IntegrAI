# Fuente para ingreso y advertencias de profesoras.
# - demo (por defecto) -> educadoras.csv, teléfonos ficticios y márgenes simulados.
# - api                -> GET /api/profesora y GET /pendientes del mismo origen.
# No agregues API keys ni secretos: las credenciales compartidas no deben ir al navegador.
VITE_REVISION=demo

# Backend IntegrAI para datos VIVOS (GET /api/datos).
# Esta selección es independiente de VITE_REVISION.
# - Sin definir   -> el dashboard usa los CSV estáticos (dataset sintético E-1).
# - "" (vacío)    -> mismo origen (CloudFront enruta /api/* al backend).
# - URL absoluta  -> ej. http://44.204.243.156:8000 (requiere CORS en el backend).
# VITE_API_BASE=
